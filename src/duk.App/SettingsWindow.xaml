<Window x:Class="duk.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - duk" Height="640" Width="900"
        MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d0d">

    <Window.Resources>
        <!-- カテゴリボタン -->
        <Style x:Key="CatBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#bbbbbb"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1a1a1a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatBtnActive" TargetType="Button" BasedOn="{StaticResource CatBtn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#1a1a1a"
                                BorderBrush="#0078d4" BorderThickness="2,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- トグルスイッチ風チェックボックス -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 設定コンボボックス -->
        <Style x:Key="SettingCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <!-- 設定テキストボックス -->
        <Style x:Key="SettingInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="CaretBrush" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Width" Value="200"/>
        </Style>

        <!-- 設定スライダー -->
        <Style x:Key="SettingSlider" TargetType="Slider">
            <Setter Property="Width" Value="160"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#0078d4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#111111"
                BorderBrush="#1e1e1e" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <TextBlock Text="設定" Foreground="White" FontSize="18"
                           FontWeight="SemiBold" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <Border Background="#1e1e1e" CornerRadius="4"
                        Width="280" Height="26"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="🔍" FontSize="11" Foreground="#555" Margin="0,0,6,0"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="#cccccc" CaretBrush="#cccccc"
                                 FontFamily="Segoe UI" FontSize="13"
                                 TextChanged="SearchBox_TextChanged"
                                 Width="240"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- メイン -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左カテゴリ -->
            <Border Grid.Column="0" Background="#111111">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CategoryPanel" Margin="0,8,0,0">
                        <Button x:Name="CatEditor"      Style="{StaticResource CatBtnActive}" Content="エディター"       Click="Category_Click" Tag="editor"/>
                        <Button x:Name="CatAppearance"  Style="{StaticResource CatBtn}"       Content="表示"             Click="Category_Click" Tag="appearance"/>
                        <Button x:Name="CatTerminal"    Style="{StaticResource CatBtn}"       Content="ターミナル"       Click="Category_Click" Tag="terminal"/>
                        <Button x:Name="CatLanguage"    Style="{StaticResource CatBtn}"       Content="言語"             Click="Category_Click" Tag="language"/>
                        <Button x:Name="CatFile"        Style="{StaticResource CatBtn}"       Content="ファイル"         Click="Category_Click" Tag="file"/>
                        <Button x:Name="CatSession"     Style="{StaticResource CatBtn}"       Content="セッション"       Click="Category_Click" Tag="session"/>
                        <Button x:Name="CatSearch"      Style="{StaticResource CatBtn}"       Content="検索"             Click="Category_Click" Tag="search"/>
                        <Button x:Name="CatKeybindings" Style="{StaticResource CatBtn}"       Content="キーボードショートカット" Click="Category_Click" Tag="keys"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Rectangle Grid.Column="1" Fill="#1e1e1e"/>

            <!-- 右設定コンテンツ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Background="#0d0d0d">
                <StackPanel Margin="24,16,24,24" x:Name="SettingsContent"/>
            </ScrollViewer>
        </Grid>

        <!-- フッター -->
        <Border Grid.Row="2" Background="#111111"
                BorderBrush="#1e1e1e" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="16,0">
                <Button Content="設定をリセット" Padding="12,6" Margin="0,0,8,0"
                        Background="#2d2d2d" Foreground="#cccccc"
                        BorderBrush="#3c3c3c" BorderThickness="1"
                        FontFamily="Segoe UI" FontSize="13" Cursor="Hand"
                        Click="Reset_Click"/>
                <Button Content="適用して閉じる" Padding="12,6"
                        Background="#0078d4" Foreground="White"
                        BorderThickness="0"
                        FontFamily="Segoe UI" FontSize="13" Cursor="Hand"
                        Click="Apply_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="duk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="duk" Height="720" Width="1280"
        MinHeight="480" MinWidth="800"
        Background="#0d0d0d"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0,0,0,0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- カラー -->
        <SolidColorBrush x:Key="BgEditor"    Color="#0d0d0d"/>
        <SolidColorBrush x:Key="BgTitle"     Color="#0d0d0d"/>
        <SolidColorBrush x:Key="BgSidebar"   Color="#111111"/>
        <SolidColorBrush x:Key="BgActivity"  Color="#111111"/>
        <SolidColorBrush x:Key="BgTabBar"    Color="#111111"/>
        <SolidColorBrush x:Key="BgTabActive" Color="#0d0d0d"/>
        <SolidColorBrush x:Key="BgHover"     Color="#1a1a1a"/>
        <SolidColorBrush x:Key="BgPressed"   Color="#252525"/>
        <SolidColorBrush x:Key="BgInput"     Color="#1e1e1e"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#cccccc"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#6e6e6e"/>
        <SolidColorBrush x:Key="Border"      Color="#1e1e1e"/>
        <SolidColorBrush x:Key="Accent"      Color="#0078d4"/>

        <!-- ControlTemplate: メニューボタン (ホバー白問題を修正) -->
        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#bbbbbb"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1e1e1e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2a2a2a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ControlTemplate: アクティビティバーボタン -->
        <Style x:Key="ActivityBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1a1a1a"/>
                                <Setter Property="Foreground" Value="#cccccc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityBtnOn" TargetType="Button" BasedOn="{StaticResource ActivityBtn}">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent"
                                BorderBrush="#cccccc" BorderThickness="2,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1a1a1a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ControlTemplate: ファイルツリーボタン -->
        <Style x:Key="FileBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#bbbbbb"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1a1a1a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ControlTemplate: ウィンドウボタン -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1e1e1e"/>
                                <Setter Property="Foreground" Value="#cccccc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#e81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- セッション作成ボタン -->
        <Style x:Key="SessionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#106ebe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- ========== タイトルバー ========== -->
        <Grid Grid.Row="0" Background="{StaticResource BgTitle}"
              MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左: メニュー -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⬡" Foreground="#444" FontSize="14"
                           VerticalAlignment="Center" Margin="10,0,6,0"/>
                <Button Style="{StaticResource MenuBtn}" Content="ファイル(F)" Click="Menu_File_Click"/>
                <Button Style="{StaticResource MenuBtn}" Content="編集(E)"/>
                <Button Style="{StaticResource MenuBtn}" Content="選択(S)"/>
                <Button Style="{StaticResource MenuBtn}" Content="表示(V)" Click="Menu_View_Click"/>
                <Button Style="{StaticResource MenuBtn}" Content="移動(G)"/>
                <Button Style="{StaticResource MenuBtn}" Content="実行(R)"/>
                <Button Style="{StaticResource MenuBtn}" Content="ターミナル(T)"/>
                <Button Style="{StaticResource MenuBtn}" Content="ヘルプ(H)"/>
            </StackPanel>

            <!-- 中央: サーチバー -->
            <Border Grid.Column="1"
                    Background="{StaticResource BgInput}"
                    CornerRadius="4" MaxWidth="400" Height="20"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <TextBlock Text="🔍" FontSize="10" Foreground="#555" Margin="0,0,4,0"/>
                    <TextBlock Text="ファイルを検索..." FontSize="12"
                               Foreground="#555" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- 右: セッション + ウィンドウボタン -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SessionBtn}"
                        Content="セッション作成"
                        Click="CreateSession_Click"/>
                <Button Style="{StaticResource WinBtn}" Content="─" Click="Win_Minimize"/>
                <Button Style="{StaticResource WinBtn}" Content="□" Click="Win_Maximize"/>
                <Button Style="{StaticResource WinBtnClose}" Content="✕" Click="Win_Close"/>
            </StackPanel>
        </Grid>

        <!-- ========== タブバー ========== -->
        <Border Grid.Row="1" Background="{StaticResource BgTabBar}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" x:Name="TabBar" VerticalAlignment="Stretch">
                <Border x:Name="Tab_ProgramCs"
                        Background="{StaticResource BgTabActive}"
                        BorderBrush="{StaticResource Accent}"
                        BorderThickness="0,1,0,0"
                        Padding="12,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Program.cs"
                                   Foreground="#cccccc" FontSize="13" FontFamily="Segoe UI"/>
                        <TextBlock Text="  ×" Foreground="#555" FontSize="12"
                                   VerticalAlignment="Center" Cursor="Hand" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ========== メインエリア ========== -->
        <Grid Grid.Row="2" x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="220" x:Name="SidebarCol"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- アクティビティバー (VSCode準拠) -->
            <DockPanel Grid.Column="0" Background="{StaticResource BgActivity}">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
                    <Button Style="{StaticResource ActivityBtn}" ToolTip="アカウント">
                        <Path Data="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"
                              Fill="#6e6e6e" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource ActivityBtn}" ToolTip="設定 (Ctrl+,)" Click="OpenSettings_Click">
                        <Path Data="M12 15.5A3.5 3.5 0 018.5 12 3.5 3.5 0 0112 8.5a3.5 3.5 0 013.5 3.5 3.5 3.5 0 01-3.5 3.5m7.43-2.92c.04-.3.07-.61.07-.93s-.03-.63-.07-.93l2-1.57c.18-.14.23-.41.12-.61l-1.9-3.29c-.12-.22-.37-.3-.59-.22l-2.36.95c-.49-.38-1.01-.7-1.58-.94l-.36-2.53c-.04-.24-.25-.41-.5-.41h-3.8c-.25 0-.46.17-.5.41l-.36 2.53c-.57.24-1.1.57-1.58.94l-2.36-.95c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2 1.57c-.04.3-.07.62-.07.95s.03.63.07.93l-2 1.57c-.18.14-.23.41-.12.61l1.9 3.29c.12.22.37.3.59.22l2.36-.95c.49.38 1.01.7 1.58.94l.36 2.53c.05.24.25.41.5.41h3.8c.25 0 .46-.17.5-.41l.36-2.53c.57-.24 1.1-.56 1.58-.94l2.36.95c.22.08.47 0 .59-.22l1.9-3.29c.12-.2.07-.47-.12-.61z"
                              Fill="#6e6e6e" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <!-- エクスプローラー -->
                    <Button x:Name="BtnExplorer" Style="{StaticResource ActivityBtnOn}"
                            ToolTip="エクスプローラー (Ctrl+Shift+E)"
                            Click="ToggleSidebar_Click">
                        <Path Data="M3 3h8v2H5v12h12v-6h2v8H3V3zm10 0h6v6h-2V6.4l-7.3 7.3-1.4-1.4L15.6 5H13V3z"
                              Fill="#cccccc" Width="20" Height="20" Stretch="Uniform"/>
                    </Button>
                    <!-- 検索 -->
                    <Button Style="{StaticResource ActivityBtn}" ToolTip="検索 (Ctrl+Shift+F)">
                        <Path Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Fill="#6e6e6e" Width="20" Height="20" Stretch="Uniform"/>
                    </Button>
                    <!-- ソース管理 -->
                    <Button Style="{StaticResource ActivityBtn}" ToolTip="ソース管理 (Ctrl+Shift+G)">
                        <Path Data="M12 3C8.13 3 5 6.13 5 10c0 2.76 1.58 5.15 3.89 6.33L7 18h10l-1.89-1.67C17.42 15.15 19 12.76 19 10c0-3.87-3.13-7-7-7zm0 2c2.76 0 5 2.24 5 5s-2.24 5-5 5-5-2.24-5-5 2.24-5 5-5zm0 1.5a3.5 3.5 0 000 7 3.5 3.5 0 000-7zM7 20v1h10v-1H7z"
                              Fill="#6e6e6e" Width="20" Height="20" Stretch="Uniform"/>
                    </Button>
                    <!-- デバッグ -->
                    <Button Style="{StaticResource ActivityBtn}" ToolTip="実行とデバッグ (Ctrl+Shift+D)">
                        <Path Data="M8 5.14v14l11-7-11-7z"
                              Fill="#6e6e6e" Width="20" Height="20" Stretch="Uniform"/>
                    </Button>
                    <!-- グループ -->
                    <Button Style="{StaticResource ActivityBtn}" ToolTip="グループセッション">
                        <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                              Fill="#6e6e6e" Width="20" Height="20" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- サイドバー -->
            <Grid Grid.Column="1" x:Name="SidebarPanel" Background="{StaticResource BgSidebar}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ヘッダー -->
                <Border Grid.Row="0">
                    <Grid>
                        <TextBlock Text="エクスプローラー"
                                   Foreground="#6e6e6e" FontSize="11" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="12,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,4,0">
                            <Button Style="{StaticResource ActivityBtn}"
                                    Width="22" Height="22" ToolTip="新しいファイル"
                                    Click="NewFile_Click">
                                <TextBlock Text="+" FontSize="14" Foreground="#6e6e6e"/>
                            </Button>
                            <Button Style="{StaticResource ActivityBtn}"
                                    Width="22" Height="22" ToolTip="フォルダを開く"
                                    Click="OpenFolder_Click">
                                <TextBlock Text="📂" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- フォルダ名 -->
                <Border Grid.Row="1" Background="#161616" Padding="8,4">
                    <TextBlock x:Name="FolderName" Text="フォルダなし"
                               Foreground="#6e6e6e" FontSize="11" FontWeight="SemiBold"
                               FontFamily="Segoe UI"/>
                </Border>

                <!-- ファイルツリー -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource BgSidebar}">
                    <StackPanel x:Name="FileTree" Margin="0,4,0,0"/>
                </ScrollViewer>
            </Grid>

            <!-- セパレーター -->
            <Rectangle Grid.Column="2" Fill="#1a1a1a"/>

            <!-- エディタ -->
            <avalonedit:TextEditor
                Grid.Column="3"
                x:Name="Editor"
                FontFamily="Consolas, 'Courier New', monospace"
                FontSize="14"
                ShowLineNumbers="True"
                LineNumbersForeground="#3e3e3e"
                WordWrap="False"
                Background="#0d0d0d"
                Foreground="#d4d4d4"
                Padding="0,4"/>
        </Grid>

        <!-- ========== ステータスバー ========== -->
        <Border Grid.Row="3" Background="#0d0d0d"
                BorderBrush="#1e1e1e" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="✕ 0" Foreground="#6e6e6e" FontSize="12"
                           FontFamily="Segoe UI" Margin="0,0,10,0"/>
                <TextBlock Text="⚠ 0" Foreground="#6e6e6e" FontSize="12" FontFamily="Segoe UI"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       x:Name="StatusSession"
                       Text="● オフライン"
                       Foreground="#555" FontSize="12" FontFamily="Segoe UI"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="StatusCursor"
                           Text="Ln 1, Col 1"
                           Foreground="#6e6e6e" FontSize="12" FontFamily="Segoe UI"
                           Margin="0,0,12,0"/>
                <TextBlock Text="Spaces: 4"
                           Foreground="#6e6e6e" FontSize="12" FontFamily="Segoe UI"
                           Margin="0,0,12,0"/>
                <TextBlock Text="UTF-8"
                           Foreground="#6e6e6e" FontSize="12" FontFamily="Segoe UI"
                           Margin="0,0,12,0"/>
                <TextBlock Text="CRLF"
                           Foreground="#6e6e6e" FontSize="12" FontFamily="Segoe UI"
                           Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusLang"
                           Text="C#"
                           Foreground="#6e6e6e" FontSize="12" FontFamily="Segoe UI"/>
            </StackPanel>
        </Grid>
        </Border>
    </Grid>
</Window>
